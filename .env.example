# Base SQLite locale : un seul fichier, sauvegardable par simple copie.
DATABASE_URL="file:./kembo.db"

# Signature des sessions. Obligatoire en production.
# Générez-en un : openssl rand -hex 32
AUTH_SECRET=""

# Code du compte gérant créé par le seed (défaut : 1234)
SEED_PIN="1234"

# Fuseau utilisé pour le découpage des journées commerciales
TZ="Africa/Brazzaville"
