# Base SQLite locale : un seul fichier, sauvegardable par simple copie.
# En production Docker, DATABASE_URL est écrasé par docker-compose.prod.yml → /data/kembo.db
DATABASE_URL="file:./kembo.db"

# Signature des sessions. OBLIGATOIRE en production.
# Générez-en un : openssl rand -hex 32
AUTH_SECRET=""

# Code PIN du compte gérant créé par le seed (défaut : 1234)
SEED_PIN="1234"

# Fuseau utilisé pour le découpage des journées commerciales
TZ="Africa/Brazzaville"

# ── Production (Docker + Traefik) ─────────────────────────────────────────────
# Résolveur de certificat TLS configuré dans Traefik (cloudflare, letsencrypt…)
TRAEFIK_CERTRESOLVER=cloudflare

# Noms des entrypoints Traefik (défauts utilisés si absent)
TRAEFIK_ENTRYPOINT_HTTP=web
TRAEFIK_ENTRYPOINT_HTTPS=websecure
