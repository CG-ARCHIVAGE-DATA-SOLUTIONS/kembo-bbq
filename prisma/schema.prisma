// Kembo BBQ — modèle de données
// SQLite : un seul fichier, sauvegarde par copie, aucun serveur à administrer.
// Prisma ne gère pas les enums sur SQLite : les valeurs cadrées sont des String
// dont la liste fait foi dans src/domain/rules.ts (source unique de vérité).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─────────────────────────────────────────────────────────── Accès

// Un point de vente se tient debout, sur téléphone : on s'identifie avec un
// code à chiffres, pas avec un mot de passe. Le code est stocké haché (scrypt).
model Utilisateur {
  id           String    @id @default(cuid())
  nom          String
  identifiant  String    @unique // court, tapé au clavier : « clive »
  codePin      String // sel:empreinte
  role         String // GERANT | VENDEUR
  actif        Boolean   @default(true)
  dernierAcces DateTime?
  createdAt    DateTime  @default(now())

  ventes Vente[]
}

// ─────────────────────────────────────────────────────────── Catalogue

model Produit {
  id        String  @id @default(cuid())
  code      String  @unique
  nom       String
  categorie String // GRILLADE | ACCOMPAGNEMENT | BOISSON | AUTRE
  unite     String // piece | portion | bouteille | kg
  prixVente Int // FCFA, entier : pas de centime en circulation

  // Suivi de stock : une sauce maison préparée sur place n'est pas suivie en lot.
  suiviStock  Boolean @default(true)
  seuilAlerte Float   @default(0)

  // Coût moyen unitaire pondéré (CMUP), recalculé à chaque entrée en stock.
  coutMoyenUnitaire Float @default(0)

  actif Boolean @default(true)
  ordre Int     @default(0) // position dans la grille de caisse

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lots           Lot[]
  mouvements     MouvementStock[]
  lignes         LigneVente[]
  consommations  ConsommationInterne[]
  ficheCout      FicheCout?

  @@index([actif, ordre])
}

// Fiche de coût complet d'une portion : sert à décider un prix de vente.
// Volontairement séparée du coût matière comptable pour éviter le double comptage
// (le charbon et l'emballage sont déjà des charges dans Depense).
model FicheCout {
  id          String  @id @default(cuid())
  produitId   String  @unique
  produit     Produit @relation(fields: [produitId], references: [id], onDelete: Cascade)
  epices      Int     @default(0)
  charbon     Int     @default(0)
  huile       Int     @default(0)
  condiments  Int     @default(0)
  emballage   Int     @default(0)
  mainDoeuvre Int     @default(0)
  autres      Int     @default(0)
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────── Achats & stock

model Lot {
  id        String   @id @default(cuid())
  reference String   @unique // LOT-20260718-001
  date      DateTime
  produitId String
  produit   Produit  @relation(fields: [produitId], references: [id])

  conditionnement          String // Carton, Sac, Cageot, Unité
  nbConditionnements       Float
  piecesParConditionnement Float
  quantiteTotale           Float // nbConditionnements * piecesParConditionnement
  montantTotal             Int // FCFA
  coutUnitaire             Float // montantTotal / quantiteTotale

  fournisseur String?
  paye        Boolean @default(true)
  note        String?

  createdAt  DateTime         @default(now())
  mouvements MouvementStock[]

  @@index([date])
  @@index([produitId, date])
}

// Journal de stock immuable : on n'écrase jamais un stock, on empile des mouvements.
// Le stock courant est toujours la somme des quantités signées.
model MouvementStock {
  id        String   @id @default(cuid())
  date      DateTime
  produitId String
  produit   Produit  @relation(fields: [produitId], references: [id])

  type         String // ENTREE_ACHAT | SORTIE_VENTE | SORTIE_INTERNE | AJUSTEMENT
  quantite     Float // signée : + entrée, − sortie
  coutUnitaire Float // CMUP figé au moment du mouvement
  valeur       Float // quantite * coutUnitaire

  lotId          String?
  lot            Lot?                 @relation(fields: [lotId], references: [id], onDelete: Cascade)
  venteId        String?
  vente          Vente?               @relation(fields: [venteId], references: [id], onDelete: Cascade)
  consommationId String?
  consommation   ConsommationInterne? @relation(fields: [consommationId], references: [id], onDelete: Cascade)

  note      String?
  createdAt DateTime @default(now())

  @@index([produitId])
  @@index([date])
  @@index([type, date])
}

// ─────────────────────────────────────────────────────────── Exploitation

model Journee {
  id         String    @id @default(cuid())
  date       DateTime  @unique // minuit, heure locale
  statut     String    @default("OUVERTE") // OUVERTE | CLOTUREE
  fondCaisse Int       @default(0)
  clotureAt  DateTime?
  note       String?

  ventes Vente[]

  @@index([date])
}

model Vente {
  id        String   @id @default(cuid())
  numero    String   @unique // TK-20260723-0001
  date      DateTime
  journeeId String
  journee   Journee  @relation(fields: [journeeId], references: [id])

  modePaiement String // ESPECES | MOBILE_MONEY | CREDIT
  encaisse     Boolean @default(true) // une vente à crédit n'entre pas en trésorerie

  total       Int // somme des lignes, remise déduite
  remise      Int   @default(0)
  coutMatiere Float // somme des coûts matière des lignes (CMUP figé)
  marge       Float // total − coutMatiere

  client String?
  note   String?

  utilisateurId String?
  utilisateur   Utilisateur? @relation(fields: [utilisateurId], references: [id])

  // Une vente saisie hors ligne est rejouée à la reconnexion : cette clé
  // garantit qu'un renvoi ne crée jamais de second ticket.
  cleIdempotence String? @unique
  horsLigne      Boolean @default(false)

  // Annulation douce : le ticket reste visible dans l'audit mais est exclu des calculs.
  annulee         Boolean   @default(false)
  annulationAt    DateTime?
  annulationPar   String?
  annulationMotif String?

  lignes     LigneVente[]
  mouvements MouvementStock[]

  createdAt DateTime @default(now())

  @@index([date])
  @@index([journeeId])
}

model LigneVente {
  id        String  @id @default(cuid())
  venteId   String
  vente     Vente   @relation(fields: [venteId], references: [id], onDelete: Cascade)
  produitId String
  produit   Produit @relation(fields: [produitId], references: [id])

  designation   String // libellé figé : le nom du produit peut changer plus tard
  quantite      Float
  prixUnitaire  Int
  total         Int
  coutUnitaire  Float // CMUP figé à l'instant de la vente
  coutMatiere   Float
  marge         Float

  @@index([venteId])
  @@index([produitId])
}

model ConsommationInterne {
  id        String   @id @default(cuid())
  date      DateTime
  produitId String
  produit   Produit  @relation(fields: [produitId], references: [id])

  quantite      Float
  motif         String // REPAS_EMPLOYE | REPAS_FAMILLE | DEGUSTATION | OFFERT | PERTE | CASSE
  coutUnitaire  Float
  valeur        Float // ce que ça coûte réellement
  manqueAGagner Int // ce que ça aurait rapporté au prix de vente
  note          String?

  mouvements MouvementStock[]
  createdAt  DateTime @default(now())

  @@index([date])
}

model Depense {
  id           String   @id @default(cuid())
  date         DateTime
  libelle      String
  categorie    String // voir CATEGORIES_DEPENSE
  montant      Int
  modePaiement String   @default("ESPECES")
  note         String?
  createdAt    DateTime @default(now())

  @@index([date])
  @@index([categorie, date])
}

model Investissement {
  id                     String   @id @default(cuid())
  date                   DateTime
  libelle                String
  categorie              String // INSTALLATION | MATERIEL | MOBILIER | VEHICULE | AUTRE
  montant                Int
  dureeAmortissementMois Int      @default(24)
  financement            String   @default("FONDS_PROPRES")
  note                   String?
  createdAt              DateTime @default(now())

  @@index([date])
}

model Apport {
  id        String   @id @default(cuid())
  date      DateTime
  libelle   String
  montant   Int
  createdAt DateTime @default(now())

  @@index([date])
}

// Réglages modifiables sans redéploiement (politique de stock, seuils, identité).
model Parametre {
  cle       String   @id
  valeur    String
  updatedAt DateTime @updatedAt
}
